    BaseType "Uncut Spirit Gem"
    SetFontSize 40
    SetTextColor 20 240 240 255
    SetBorderColor 20 240 240 255
    SetBackgroundColor 6 0 60 255
    PlayAlertSound 2 250
    PlayEffect Cyan
