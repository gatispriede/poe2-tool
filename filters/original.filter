# === JEWELS — uniques always; hide basic Ruby/Emerald/Sapphire; keep rest (Diamond, Time-Lost, Timeless) ===
Show
    Class == "Jewels"
    Rarity Unique
    SetFontSize 38
    SetTextColor 0 255 0 255
    SetBorderColor 0 255 0 255
    SetBackgroundColor 0 40 0 230
    PlayAlertSound 4 250
    PlayEffect Green
    MinimapIcon 1 Green Kite

Hide
    Class == "Jewels"
    BaseType == "Ruby" "Emerald" "Sapphire"

