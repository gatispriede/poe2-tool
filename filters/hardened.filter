# === CUSTOM RULES ===

# === RUNESEEKER'S QUEST RUNE — Depleted/Infused Mana Rune (Uhtred drop -> Runeseeker's Call, 800+ div) ===
Show
    BaseType == "Depleted Mana Rune" "Infused Mana Rune"
    SetFontSize 45
    SetTextColor 255 0 0 255
    SetBorderColor 255 0 0 255
    SetBackgroundColor 255 255 255 255
    PlayAlertSound 6 300
    PlayEffect Red
    MinimapIcon 0 Red Star

# === SEKHEMAS TREASURE KEYS — loud + big minimap icon (ground drops inside Trial) ===
# Gold = highest value (red star), Silver (white star), Bronze (yellow star)
Show
    BaseType == "Gold Key"
    SetFontSize 45
    SetTextColor 255 255 255 255
    SetBorderColor 255 215 0 255
    SetBackgroundColor 130 80 0 255
    PlayAlertSound 6 300
    PlayEffect Yellow
    MinimapIcon 0 Yellow Star

Show
    BaseType == "Silver Key"
    SetFontSize 45
    SetTextColor 255 255 255 255
    SetBorderColor 220 220 220 255
    SetBackgroundColor 70 70 80 255
    PlayAlertSound 1 300
    PlayEffect White
    MinimapIcon 0 White Star

Show
    BaseType == "Bronze Key"
    SetFontSize 42
    SetTextColor 255 255 255 255
    SetBorderColor 200 120 50 255
    SetBackgroundColor 70 40 10 255
    PlayAlertSound 2 300
    PlayEffect Orange
    MinimapIcon 1 Orange Star

# === RECOMBINATOR FODDER — items with max-tier +Skills / +Spirit mods ===
# Caster weapons: Runic (+Lvl all Spell Skills), of the Wizard, of Inferno/Frostbite/Thunder/Armageddon/Grief
Show
    Identified True
    Rarity Normal Magic Rare
    Class == "Staves" "Wands"
    HasExplicitMod >=1 "Runic" "of the Wizard" "of Inferno" "of Frostbite" "of Thunder" "of Armageddon" "of Grief"
    SetFontSize 42
    SetTextColor 0 240 190 255
    SetBorderColor 0 240 190 255
    SetBackgroundColor 47 0 74 255
    PlayAlertSound 3 300
    PlayEffect Blue
    MinimapIcon 0 Blue Diamond

# Sceptres: Empowering (+Lvl all Skills), King's, of the Slavedriver
Show
    Identified True
    Rarity Normal Magic Rare
    Class == "Sceptres"
    HasExplicitMod >=1 "Empowering" "King's" "of the Slavedriver"
    SetFontSize 42
    SetTextColor 0 240 190 255
    SetBorderColor 0 240 190 255
    SetBackgroundColor 47 0 74 255
    PlayAlertSound 3 300
    PlayEffect Blue
    MinimapIcon 0 Blue Diamond

# Amulets: Countess' (+Spirit), of the Sharpshooter (+Projectile Skills)
Show
    Identified True
    Rarity Normal Magic Rare
    Class == "Amulets"
    HasExplicitMod >=1 "Countess'" "of the Sharpshooter"
    SetFontSize 42
    SetTextColor 0 240 190 255
    SetBorderColor 0 240 190 255
    SetBackgroundColor 47 0 74 255
    PlayAlertSound 3 300
    PlayEffect Blue
    MinimapIcon 0 Blue Diamond

# Bows/Crossbows: of Many (proj level), Merciless, of the Sniper
Show
    Identified True
    Rarity Normal Magic Rare
    Class == "Bows" "Crossbows"
    HasExplicitMod >=1 "of Many" "Merciless" "of the Sniper"
    SetFontSize 42
    SetTextColor 0 240 190 255
    SetBorderColor 0 240 190 255
    SetBackgroundColor 47 0 74 255
    PlayAlertSound 3 300
    PlayEffect Blue
    MinimapIcon 0 Blue Diamond

# Boots: Hellion's (+30% MS)
Show
    Identified True
    Rarity Normal Magic Rare
    Class == "Boots"
    HasExplicitMod >=1 "Hellion's"
    SetFontSize 42
    SetTextColor 0 240 190 255
    SetBorderColor 0 240 190 255
    SetBackgroundColor 47 0 74 255
    PlayAlertSound 3 300
    PlayEffect Blue
    MinimapIcon 0 Blue Diamond

# === CHARM Q18+ ilvl 82+ — chase crafting bases (loud teal) ===
Show
    Class == "Charms"
    Rarity Normal Magic
    Quality >= 18
    ItemLevel >= 82
    SetFontSize 42
    SetTextColor 0 240 190 255
    SetBorderColor 0 240 190 255
    SetBackgroundColor 0 75 30 255
    PlayAlertSound 3 300
    PlayEffect Blue
    MinimapIcon 0 Blue Diamond

# === VAAL SIPHONER (class-agnostic, per user) ===
Show
    BaseType == "Vaal Siphoner"
    SetFontSize 40
    SetTextColor 255 245 180 255
    SetBorderColor 245 105 90 255
    SetBackgroundColor 60 30 0 255
    PlayAlertSound 2 250
    PlayEffect Yellow
    MinimapIcon 1 Yellow Circle

# === SHOW-ALL CARVE-OUTS ===
Show
    Class == "Charms"
    Quality >= 10
    SetFontSize 38
    SetTextColor 200 200 0 255
    SetBorderColor 200 200 0 255

Hide
    # [auto] enumerated by scripts/filter/harden-filter.js
    BaseType == "Amethyst Charm" "Antidote Charm" "Cleansing Charm" "Dousing Charm" "Golden Charm" "Grounding Charm" "Ruby Charm" "Sapphire Charm" "Silver Charm" "Staunching Charm" "Stone Charm" "Thawing Charm" "Topaz Charm"
    Class == "Charms"

# === IDOLS — show all, distinct green + minimap (per user: make sure none are missed) ===
Show
    Class == "Augment"
    BaseType "Idol"
    SetFontSize 42
    SetTextColor 120 255 200 255
    SetBorderColor 0 255 180 255
    SetBackgroundColor 0 50 40 255
    PlayAlertSound 3 250
    PlayEffect Green
    MinimapIcon 1 Green Kite

# === HIDE low-worth runes (< 5 ex per poe.ninja 2026-07) ===
Hide
    Class == "Augment"
    BaseType == "Ancient Rune of Animosity" "Ancient Rune of Decay" "Ancient Rune of Dueling" "Ancient Rune of Prowess" "Ancient Rune of Retaliation" "Ancient Rune of Splinters" "Ancient Rune of Witchcraft" "Ancient Rune of the Horde" "Ancient Rune of the Titan" "Breath of Aldur" "Charging Rune" "Farrul's Rune of Grace" "Fenumus' Rune of Draining" "Greater Adept Rune" "Greater Body Rune" "Greater Desert Rune" "Greater Glacial Rune" "Greater Inspiration Rune" "Greater Rebirth Rune" "Greater Resolve Rune" "Greater Robust Rune" "Greater Stone Rune" "Greater Storm Rune" "Greater Vision Rune" "Ire of Aldur" "Lady Hestra's Rune of Winter" "Lesser Mind Rune" "Lesser Stone Rune" "Lesser Vision Rune" "Mind Rune" "Passion of Aldur" "Rune of Confrontation" "Rune of Consistency" "Rune of Vital Flame" "Saqawal's Rune of Erosion" "Stone Rune" "Thane Girt's Rune of Wildness" "Thane Leld's Rune of Spring" "Thane Myrk's Rune of Summer" "Warding Rune of Annihilation" "Warding Rune of Armature" "Warding Rune of Bodyguards" "Warding Rune of Courage" "Warding Rune of Desperation" "Warding Rune of Glancing" "Warding Rune of Obsession" "Warding Rune of Salvaging" "Warding Rune of Symbiosis"

# === SOCKETABLES (Runes / Soul Cores / Idols) — show all, minimap + beam so none are missed ===
Show
    Class == "Augment"
    SetFontSize 42
    SetTextColor 255 220 150 255
    SetBorderColor 220 175 132 255
    SetBackgroundColor 45 30 5 255
    PlayAlertSound 3 200
    PlayEffect Yellow
    MinimapIcon 1 Yellow Kite

