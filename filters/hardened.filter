# === EXCEPTIONAL GEAR — high quality OR oversocket, any ilvl, all rarities ===
Show
    Rarity Normal Magic Rare
    Quality >= 20
    SetFontSize 42
    SetTextColor 100 255 255 255
    SetBorderColor 100 255 255 255
    SetBackgroundColor 0 40 60 255
    PlayAlertSound 3 300
    PlayEffect Cyan
    MinimapIcon 0 Cyan Diamond

Show
    Rarity Normal Magic Rare
    Sockets >= 3
    Class == "Body Armours" "Bows" "Crossbows" "Quarterstaves" "Staves" "Talismans" "Two Hand Maces"
    SetFontSize 42
    SetTextColor 100 255 255 255
    SetBorderColor 100 255 255 255
    SetBackgroundColor 0 40 60 255
    PlayAlertSound 3 300
    PlayEffect Cyan
    MinimapIcon 0 Cyan Diamond

Show
    Rarity Normal Magic Rare
    Sockets >= 2
    Class == "Boots" "Bucklers" "Foci" "Gloves" "Helmets" "One Hand Maces" "Sceptres" "Shields" "Spears" "Wands"
    SetFontSize 42
    SetTextColor 100 255 255 255
    SetBorderColor 100 255 255 255
    SetBackgroundColor 0 40 60 255
    PlayAlertSound 3 300
    PlayEffect Cyan
    MinimapIcon 0 Cyan Diamond

# === VENDOR QUALITY — items carrying Quality sell back as quality currency ===
# Quality >= 1. Placed above the blanket hides so these stop being swallowed.
# Pink background per currency family; anything already matched by a louder rule above keeps it.

# Armourer's Scrap
Show
    Class == "Body Armours" "Helmets" "Gloves" "Boots" "Shields" "Bucklers"
    Quality >= 1
    SetFontSize 36
    SetTextColor 255 190 230 255
    SetBorderColor 255 105 180 255
    SetBackgroundColor 90 20 60 255

# Blacksmith's Whetstone
Show
    Class == "One Hand Axes" "Two Hand Axes" "One Hand Maces" "Two Hand Maces" "One Hand Swords" "Two Hand Swords" "Spears" "Flails" "Claws" "Daggers" "Bows" "Crossbows" "Quarterstaves"
    Quality >= 1
    SetFontSize 36
    SetTextColor 255 190 230 255
    SetBorderColor 255 105 180 255
    SetBackgroundColor 120 20 70 255

# Arcanist's Etcher
Show
    Class == "Wands" "Sceptres" "Staves" "Foci"
    Quality >= 1
    SetFontSize 36
    SetTextColor 255 190 230 255
    SetBorderColor 255 105 180 255
    SetBackgroundColor 110 20 110 255

# Glassblower's Bauble
