# === GOLD — only 500+ piles (per user) ===
Show
    BaseType == "Gold"
    StackSize >= 1000
    SetFontSize 38
    SetTextColor 255 220 100 255
    SetBorderColor 220 170 50 255
    PlayEffect Orange Temp

Hide
    BaseType == "Gold"

# === EXTRA-SOCKETED (uncorrupted) — always show, any ilvl/tier (per user) ===
Show
    Rarity Normal Magic Rare
    Corrupted False
    Sockets >= 3
    Class == "Body Armours" "Bows" "Crossbows" "Quarterstaves" "Staves" "Talismans" "Two Hand Maces"
    SetFontSize 42
    SetTextColor 100 255 255 255
    SetBorderColor 100 255 255 255
    SetBackgroundColor 0 40 60 255
    PlayAlertSound 3 300
    PlayEffect Cyan
    MinimapIcon 0 Cyan Diamond

Show
    Rarity Normal Magic Rare
    Corrupted False
    Sockets >= 2
    Class == "Boots" "Bucklers" "Foci" "Gloves" "Helmets" "One Hand Maces" "Sceptres" "Shields" "Spears" "Wands"
    SetFontSize 42
    SetTextColor 100 255 255 255
    SetBorderColor 100 255 255 255
    SetBackgroundColor 0 40 60 255
    PlayAlertSound 3 300
    PlayEffect Cyan
    MinimapIcon 0 Cyan Diamond

